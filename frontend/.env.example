# Copy to .env (Docker Compose reads it automatically) or .env.local (next dev).

# --- database ---------------------------------------------------------------
POSTGRES_USER=cbc
POSTGRES_PASSWORD=cbc
POSTGRES_DB=cbc
# Host port for the containerised Postgres. 5432 is usually taken by a native
# install, so the compose file publishes 5433 by default.
DB_HOST_PORT=5433
# Used by the app processes. Inside compose the host is `db`; outside it is
# localhost on DB_HOST_PORT.
DATABASE_URL=postgres://cbc:cbc@localhost:5433/cbc

# --- Antigravity CLI --------------------------------------------------------
# Path to the agy binary. `agy` inside the container; the .exe on Windows if you
# run the gateway on the host instead.
AGY_BIN=agy
# agy is always launched from the workspace root.
WORKSPACE_ROOT=/workspace
# Host path seeded into the workspace volume on first boot, mounted read-only.
# Defaults to the parent of this folder, i.e. the CBC workspace itself.
CBC_WORKSPACE_HOST=..
# Optional. `agy models` lists the ids; leave blank to use the CLI default.
AGY_MODEL=
# low | medium | high. Blank uses the CLI default.
AGY_EFFORT=
# Print-mode timeout for a single run. A full Phase 0-6 estimate is slow.
AGY_TIMEOUT=30m

# --- domain gate ------------------------------------------------------------
# The gate classifies a message only when its deterministic screen is undecided.
# That classifier runs agy from an EMPTY directory on purpose: agy resolves
# `.agent/` from its cwd, so an empty one loads no MCP servers and no workspace
# rules. Leave blank for a temp dir. Never point this at the workspace.
GATEKEEPER_CWD=
# One token in, one token out - no deliberation needed.
GATEKEEPER_EFFORT=low
# Short: this runs ahead of every ambiguous chat turn. Exceeding it refuses.
GATEKEEPER_TIMEOUT=2m

# Passphrase used to unlock the container's gnome-keyring, which is where agy
# caches its OAuth credentials. Any non-empty value; it never leaves the volume.
KEYRING_PASSWORD=change-me

# --- services ---------------------------------------------------------------
AGENT_URL=http://localhost:8787
AGENT_HOST_PORT=8787
WEB_HOST_PORT=3000
# Estimates processed in parallel by one agent replica.
WORKER_CONCURRENCY=2
MAX_UPLOAD_MB=200

# --- email intake -----------------------------------------------------------
# Mail a bid set to the inbox below and it becomes a project with a running estimate.
#
# Read this before switching it on. Accepting a message ends in an agy run with
# --dangerously-skip-permissions, write access to the whole workspace and the
# gateway's environment, for up to AGY_TIMEOUT. An inbox is reachable by anyone
# who learns the address, so the allowlist is the only thing standing between a
# stranger and that. Nothing from the mail body ever reaches a prompt.
#
# Off unless this is exactly 1/true/yes.
INTAKE_ENABLED=0
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# The poller never writes to the mailbox - it tracks a UID high-water mark instead of
# flagging mail read - and starts from whatever arrives AFTER it first runs. Pointing it
# at a dedicated Gmail label (with a filter routing bid sets there) still keeps the
# unrelated traffic out of its way entirely.
IMAP_MAILBOX=INBOX
# This file is TRACKED. Put real values in .env, which is not.
IMAP_USER=
# Google App Password (needs 2FA on the account). NOT the account password.
IMAP_PASSWORD=
# Comma-separated addresses that may trigger an estimate. EMPTY ACCEPTS NOTHING -
# an unconfigured allowlist must mean "no estimates ran", never "anyone may run one".
# SPF and DKIM must also pass, or a From header would be enough to impersonate one.
INTAKE_ALLOWED_SENDERS=
INTAKE_POLL_MS=60000
# Backpressure. Nothing else in this system caps the queue.
INTAKE_MAX_PER_CYCLE=5
INTAKE_MAX_PER_SENDER_PER_DAY=20
INTAKE_MAX_PENDING_RUNS=25
# A junk PDF costs a full run, so the workspace indexer vets it first (seconds).
INTAKE_PLAN_CHECK_TIMEOUT_MS=120000

# --- backups ----------------------------------------------------------------
BACKUP_INTERVAL_SECONDS=3600
BACKUP_KEEP=24
